#!/bin/sh
# Second wall in front of main: the repository rules (ruleset "protect main")
# reject the push on the server anyway, so this hook only arrives first and
# explains the flow instead of a bare GH013. It never blocks a branch.
# Read what it protects: docs/CONVENTIONS.md#branches.
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    blocked=1
  fi
done
if [ "$blocked" -eq 0 ]; then
  exit 0
fi
echo "pre-push: main is protected, it only moves through a pull request." >&2
echo "" >&2
echo "  Work on a branch and open a PR instead:" >&2
echo "" >&2
echo "    git switch -c feat/<name>" >&2
echo "    git commit" >&2
echo "    git push -u origin feat/<name>" >&2
echo "    gh pr create" >&2
echo "" >&2
echo "  The PR needs the check workflow green and one merge to land on main." >&2
echo "  See docs/CONVENTIONS.md#branches." >&2
exit 1
