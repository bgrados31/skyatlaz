{
  "schemaVersion": 1,
  "id": "skyatlaz",
  "version": "${version}",
  "name": "skyatlaz",
  "description": "All-in-one quality of life mod for Hypixel SkyBlock.",
  "authors": ["tnozamas"],
  "contact": {
    "homepage": "https://github.com/bgrados31/skyatlaz",
    "sources": "https://github.com/bgrados31/skyatlaz",
    "issues": "https://github.com/bgrados31/skyatlaz/issues"
  },
  "license": "LGPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "org.tnozamas.skyatlaz.Skyatlaz"
      }
    ]
  },
  "mixins": [
    "skyatlaz.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "fabric-api": "*",
    "hypixel-mod-api": ">=1.0",
    "minecraft": "${minecraft_version}"
  }
}
